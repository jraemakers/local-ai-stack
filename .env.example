# Copy this file to .env and fill in the secrets:
#   cp .env.example .env
# Generate each secret with: openssl rand -hex 32

# Keeps you logged in to Open WebUI across updates
WEBUI_SECRET_KEY=

# Required by SearXNG
SEARXNG_SECRET=

# Which network interface the web UIs listen on.
# 127.0.0.1 = only this computer (default)
# 0.0.0.0   = also reachable from your LAN / Tailscale
BIND_ADDRESS=127.0.0.1

# Uncomment to give Open WebUI an NVIDIA GPU (needs the NVIDIA Container Toolkit)
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
